# 从阿里云百炼控制台创建。不要把真实密钥提交到仓库。
DASHSCOPE_API_KEY=

# 从百炼控制台复制当前业务空间的 API Host，各地域地址不同。
# 示例格式：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=

# 填写已开通且支持 JSON Schema 结构化输出的模型名称。
DASHSCOPE_MODEL=

# 服务端模型请求超时，允许范围 3000—30000 毫秒。
MODEL_TIMEOUT_MS=8000

# 本地网页服务端口。
PORT=4173
